---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.tsx";
import HeaderAuth from "../components/HeaderAuth.tsx";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "BM Tools - developer utilities",
  description = "Fast, private, client-side developer tools. Lorem ipsum & text generator, counters, converters and more. Nothing leaves your browser.",
} = Astro.props;

// Base-aware links (project page served under /mra-bm-tools/). Normalize: no trailing
// slash, then always join with a leading slash so links have exactly one separator.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/company-logo.webp`} />

    <!-- No-flash theme: apply saved/OS theme before first paint. Light is default. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "dark") document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <header
      class="sticky top-0 z-40 border-b backdrop-blur"
      style="border-color: var(--border); background: color-mix(in srgb, var(--bg) 85%, transparent);"
    >
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
        <a href={`${base}/`} class="flex items-center gap-2" aria-label="BitMascot - home">
          {/* Green mark stays constant; wordmark uses --text so it flips per theme (no pill needed). */}
          <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path d="M29 4 L4 15 L13 18 L15 27 Z" fill="#74b174" />
            <g stroke="#74b174" stroke-width="2.4" stroke-linecap="round">
              <line x1="19" y1="6" x2="21.5" y2="2" />
              <line x1="24" y1="4" x2="25" y2="0.8" />
              <line x1="28" y1="6" x2="31" y2="3.8" />
              <line x1="29.5" y1="10" x2="31.5" y2="12" />
              <line x1="22.5" y1="8.5" x2="24" y2="5.5" />
            </g>
          </svg>
          <span class="text-lg font-bold tracking-tight" style="color: var(--text)">BitMascot</span>
        </a>
        <div class="flex items-center gap-2">
          <ThemeToggle client:load />
          <HeaderAuth client:only="react" />
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-4 py-10 text-sm" style="color: var(--text-muted)">
      <p>Most tools run entirely in your browser. Pastebin data is stored securely and auto-deleted within 30 days.</p>
    </footer>
  </body>
</html>
