---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { READY_TOOLS, getTool } from "../../lib/tools-registry.ts";
import TextGenerator from "../../components/tools/TextGenerator.tsx";

export function getStaticPaths() {
  return READY_TOOLS.map((tool) => ({ params: { slug: tool.slug } }));
}

const { slug } = Astro.params;
const tool = getTool(slug!);
const base = import.meta.env.BASE_URL.replace(/\/$/, ""); // no trailing slash; join with a leading slash
if (!tool) return Astro.redirect(`${base}/404`);
---

<BaseLayout title={`${tool.name} - BM Tools`} description={tool.description}>
  <a
    href={`${base}/`}
    class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
    style="color: var(--text-muted)"
  >
    ← All tools
  </a>

  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight" style="color: var(--text)">{tool.name}</h1>
    <p class="mt-1.5 max-w-2xl text-sm" style="color: var(--text-muted)">{tool.description}</p>
  </div>

  {/* One line per ready tool - statically analyzable so Astro can hydrate the island. */}
  {tool.slug === "text-generator" && <TextGenerator client:only="react" />}
</BaseLayout>
