# ─────────────────────────────────────────────────────────────
# FRONTEND (Astro) env — only PUBLIC_* vars reach the browser.
# Copy to `.env` and fill. `.env` is gitignored.
#
# Auth model: Supabase email magic-link / OTP, locked to @webalive.com.au.
# No backend server — the frontend talks straight to Supabase (Auth + Postgres + RLS).
# The anon key is safe to expose; Row-Level Security enforces all access rules.
#
# ANYTHING WITHOUT THE `PUBLIC_` PREFIX IS NOT AVAILABLE IN THE BROWSER.
# Astro inlines every PUBLIC_* value into the JavaScript bundle, so never put a
# secret behind a PUBLIC_ name. Secrets belong in Supabase Edge Function secrets
# (`supabase secrets set NAME=value`), not in this file.
# ─────────────────────────────────────────────────────────────


# ── Supabase (required) ──────────────────────────────────────
# Project Settings → API. Powers auth + pastebin + link shortener.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=


# ── Link shortener (tool: /tools/link-shortener) ─────────────
# Which backend creates short links. One of:
#   supabase  - self-hosted in the `links` table. Custom codes, expiry, ownership,
#               click counts, delete. Short URL is <PUBLIC_SHORT_BASE_URL>/l/<code>.
#               Needs no extra key. DEFAULT.
#   tinyurl   - TinyURL's keyless public endpoint (api-create.php). Real tinyurl.com
#               domain, but links are permanent, public, and not owned by anyone —
#               no expiry, no custom alias, no delete, no stats.
#   ulvis     - ulvis.net free API. Custom alias, expiry, password, use-count.
#               Sends no CORS headers, so it CANNOT be called from the browser —
#               requires the Supabase Edge Function proxy below.
PUBLIC_SHORTENER_PROVIDER=supabase

# Origin used to build the short link shown to the user.
# Leave blank to fall back to window.location.origin + Astro's base path.
# Set this once a dedicated short domain exists (e.g. https://bm.li).
PUBLIC_SHORT_BASE_URL=

# Length of the auto-generated short code when the user does not supply one.
PUBLIC_SHORT_CODE_LENGTH=6

# Max lifetime, in days, of a short link. Mirrors the pastebin 30-day cap and the
# CHECK constraint in supabase/schema.sql. Raising this here alone does nothing —
# the database constraint has to change too.
PUBLIC_SHORT_MAX_AGE_DAYS=30


# ── OPTIONAL: ulvis.net (only if PUBLIC_SHORTENER_PROVIDER=ulvis) ──
# ulvis needs no API key, but it sends no Access-Control-Allow-Origin header, so a
# browser fetch() to it fails. Calls must go through a Supabase Edge Function that
# proxies ulvis.net/API/write/get. Point this at that function's URL:
#   https://<project-ref>.supabase.co/functions/v1/shorten
PUBLIC_SHORTENER_PROXY_URL=

# Signature ulvis attaches to links created by this app (their `via` parameter).
# Purely for attribution in their logs; safe to expose.
PUBLIC_ULVIS_VIA=bm-tools

# ── OPTIONAL: TinyURL authenticated API ──────────────────────
# Only needed if you want custom aliases + click analytics on a real tinyurl.com
# link (api.tinyurl.com instead of the keyless api-create.php endpoint).
#
# SECURITY: this token must NOT be exposed to the browser, so it is deliberately
# not PUBLIC_. Using it requires a Supabase Edge Function to hold the secret and
# proxy the call. Set it with:  supabase secrets set TINYURL_API_TOKEN=...
# Listed here only so the required name is documented in one place.
TINYURL_API_TOKEN=


# ── Resend (auth email delivery) ─────────────────────────────
# Supabase sends the sign-in codes, not this app — so the live copy of this key
# lives in the Supabase dashboard, not here:
#   Authentication → Emails → SMTP Settings
#     Host     smtp.resend.com
#     Port     465
#     Username resend            (the literal word)
#     Password <this key>
#     Sender   noreply@webalive.com.au
#
# Recorded here so the key name is documented, and for any future Edge Function
# that calls the Resend API directly.
#
# NO `PUBLIC_` PREFIX ON PURPOSE — Astro inlines every PUBLIC_* value into the
# browser bundle. Prefixing this would publish the key to anyone viewing source.
#
# DNS: verify the ROOT domain webalive.com.au in Resend, never a subdomain.
# DMARC there is `p=reject; adkim=s`, so DKIM only aligns when the signature's
# `d=` tag is exactly webalive.com.au. A subdomain fails and every login code
# gets rejected outright.
RESEND_API_KEY=


# ── OPTIONAL: error / usage reporting ────────────────────────
# Leave blank to disable. Only set if you actually wire a reporter up.
PUBLIC_SENTRY_DSN=
